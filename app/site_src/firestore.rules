rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 관리자 명단: 콘솔에서만 추가합니다. 앱은 자기 문서가 있는지만 확인합니다.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // 개인 기록: 이름+숫자 4자리로 만든 열쇠(64자)를 아는 사람만 읽고 씁니다. 목록 보기는 막아 둡니다.
    match /readers/{key} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create, update: if signedIn()
        && key.size() == 64
        && request.resource.data.keys().hasOnly(['name', 'data', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.data is string && request.resource.data.data.size() < 800000;
    }

    // 함께 읽기 숫자: 한 번에 1씩만 올릴 수 있습니다.
    match /days/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['done']) && request.resource.data.done == 1;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['done']) && request.resource.data.done == resource.data.done + 1;
      allow delete: if false;
    }
    match /dates/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['done']) && request.resource.data.done == 1;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['done']) && request.resource.data.done == resource.data.done + 1;
      allow delete: if false;
    }
    // 피드백: 누구나 쓰기만, 읽기·지우기는 관리자만.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'name', 'plan', 'day', 'ua', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // 개발자 모드 글자 바꾸기표: 누구나 읽고, 관리자만 고칩니다.
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // 함께 읽기(이름 공개를 켠 사람만): 별명·작은 사진·아멘한 성품·붙잡은 구절. 문서 이름은 열쇠에서 만든 공개 번호(24자)
    match /together/{day}/p/{who} {
      allow read: if signedIn();
      allow create, update: if signedIn() && who.size() == 24 && day.size() <= 20
        && request.resource.data.keys().hasOnly(['nick', 'ph', 'amen', 'kv', 'read', 'at'])
        && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 20
        && (request.resource.data.ph == null || (request.resource.data.ph is string && request.resource.data.ph.size() < 20000))
        && request.resource.data.amen is list && request.resource.data.amen.size() <= 60
        && request.resource.data.kv is string && request.resource.data.kv.size() <= 20
        && request.resource.data.read is bool && request.resource.data.at is number;
      allow delete: if signedIn() && who.size() == 24;
    }
    match /stats/church {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['readers']) && request.resource.data.readers == 1;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['readers']) && request.resource.data.readers == resource.data.readers + 1;
      allow delete: if false;
    }
  }
}
