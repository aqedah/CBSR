[{"id": "exodus", "n": "출애굽 40년", "sub": "라암셋에서 여리고까지 · 출애굽기–여호수아", "who": "모세", "as_": "moses", "grp": "이스라엘 백성", "big": 2, "d": "애굽을 떠난 이스라엘이 홍해를 건너 시내 산에서 언약을 받고, 불순종으로 광야를 사십 년 돈 뒤 요단을 건너 가나안에 들어가기까지의 길입니다.", "start": ["라암셋", 30.8, 31.83], "steps": [{"t": "애굽을 떠나다", "s": "1년째 1월 15일", "n": "유월절 다음 날, 이스라엘이 라암셋을 떠나 숙곳에 이릅니다.", "p": [["숙곳", 30.55, 32.1]], "r": [2, 12, 37], "z": 8.5}, {"t": "구름 기둥과 불 기둥", "s": "숙곳 → 에담", "n": "하나님이 블레셋 사람의 길 대신 광야 길로 이끄시고, 앞서 가시며 길을 보여 주십니다.", "p": [["에담", 30.45, 32.35]], "r": [2, 13, 21], "z": 8.5}, {"t": "돌이켜 바닷가에 진을 치다", "s": "에담 → 비하히롯", "n": "하나님은 길을 돌이켜 바다 앞에 진을 치게 하십니다. 뒤에서는 바로의 군대가 쫓아옵니다.", "p": [["비하히롯", 29.73, 32.37]], "r": [2, 14, 2], "z": 9}, {"t": "바다 가운데 마른 땅", "s": "홍해를 건넘", "n": "모세가 손을 내밀자 밤새 동풍이 불어 물이 갈라지고, 백성이 마른 땅으로 건넙니다.", "p": [["홍해를 건넘", 29.72, 32.73]], "pre": [2, 14, 21], "r": [2, 14, 22], "z": 10.5, "fx": "part"}, {"t": "쓴 물과 엘림의 샘", "s": "마라 → 엘림", "n": "마라의 쓴 물이 달게 되고, 엘림에서 샘 열둘과 종려나무 일흔 그루 곁에 장막을 칩니다.", "p": [["마라", 29.35, 32.95], ["엘림", 29.25, 33.02]], "r": [2, 15, 27], "z": 9}, {"t": "하늘에서 내린 만나", "s": "신 광야", "n": "양식이 없다고 원망하는 백성에게 하나님은 날마다 만나를 내리십니다.", "p": [["신 광야", 28.85, 33.4]], "r": [2, 16, 35], "z": 8.5}, {"t": "반석에서 나온 물", "s": "르비딤", "n": "마실 물이 없어 다투는 르비딤에서, 모세가 반석을 치자 물이 나옵니다.", "p": [["르비딤", 28.7, 33.62]], "r": [2, 17, 6], "z": 9}, {"t": "시내 산에 이르다", "s": "3개월째", "n": "애굽을 떠난 지 석 달, 이스라엘이 하나님의 산 앞에 진을 칩니다.", "p": [["시내 산", 28.54, 33.97]], "r": [2, 19, 1], "z": 10}, {"t": "시내 산에서 약 1년", "s": "율법과 성막", "n": "하나님이 언약과 율법을 주시고, 백성은 성막을 지어 세웁니다. 하나님의 영광이 성막에 가득합니다.", "stay": 1, "r": [2, 40, 34], "z": 9}, {"t": "구름이 떠오르다", "s": "2년째 2월 20일 · 바란 광야로", "n": "구름이 성막에서 떠오르자 백성이 하세롯을 지나 바란 광야로 행진합니다.", "p": [["하세롯", 28.97, 34.42], ["", 29.6, 34.75], ["바란 광야", 30.4, 34.6]], "r": [4, 10, 12], "z": 7.5}, {"t": "가데스에서 돌아서다", "s": "정탐과 불신", "n": "열두 정탐꾼 가운데 열 명의 나쁜 보고에 백성이 울며 원망합니다. 그 세대는 광야에서 사십 년을 보내게 됩니다.", "p": [["가데스", 30.69, 34.49]], "r": [4, 14, 33], "z": 8.5}, {"t": "광야의 38년", "s": "세일 산을 두루 다님", "n": "백성은 오랫동안 광야를 돌아다닙니다. 그러나 그 사십 년 동안 하나님이 함께하셔서 부족함이 없었습니다.", "p": [["", 30.25, 34.75], ["", 29.95, 35.0], ["에시온게벨", 29.55, 34.95], ["", 30.0, 35.15], ["", 30.45, 34.85], ["가데스", 30.69, 34.49]], "dash": 1, "r": [5, 2, 7], "z": 7.5}, {"t": "호르 산에서 아론이 죽다", "s": "40년째 5월 1일", "n": "가데스를 떠나 호르 산에 이르고, 대제사장 아론이 산 꼭대기에서 죽습니다.", "p": [["호르 산", 30.32, 35.41]], "r": [4, 20, 28], "z": 8.5}, {"t": "에돔을 돌아서", "s": "놋뱀", "n": "에돔이 길을 내주지 않아 멀리 돌아갑니다. 원망하던 백성이 뱀에 물리자, 놋뱀을 쳐다본 사람은 살아납니다.", "p": [["", 29.95, 35.1], ["", 29.62, 35.02], ["", 29.9, 35.6], ["", 30.4, 35.85], ["세렛 시내", 31.05, 35.72], ["아르논", 31.45, 35.75]], "r": [4, 21, 9], "z": 7.5}, {"t": "모압 평지에 진을 치다", "s": "요단 건너편", "n": "시혼과 옥을 이기고, 여리고 맞은편 모압 평지에 진을 칩니다. 모세가 신명기의 말씀을 전합니다.", "p": [["헤스본", 31.8, 35.81], ["모압 평지", 31.83, 35.62]], "r": [4, 22, 1], "z": 9}, {"t": "느보 산에서 바라본 땅", "s": "모세의 마지막", "n": "모세는 느보 산에 올라 약속의 땅을 바라봅니다. 들어가지는 못하고 그곳에서 죽습니다.", "p": [["느보 산", 31.77, 35.73]], "r": [5, 34, 4], "z": 10.5}, {"t": "요단을 건너다", "s": "40년째 1월 10일", "who": "여호수아", "as_": "soldier", "n": "여호수아가 백성을 이끕니다. 언약궤를 멘 제사장들이 요단 가운데 서고, 백성이 마른 땅으로 건넙니다.", "p": [["싯딤", 31.84, 35.66], ["길갈", 31.86, 35.5]], "r": [6, 3, 17], "z": 10.5, "fx": "jordan"}, {"t": "만나가 그치다", "s": "길갈", "n": "가나안 땅의 소산을 먹은 다음 날, 사십 년 동안 내리던 만나가 그칩니다.", "stay": 1, "r": [6, 5, 12], "z": 10}, {"t": "여리고 성이 무너지다", "s": "약속의 땅에서 첫 싸움", "n": "백성이 성을 일곱 바퀴 돌고 외치자 여리고 성벽이 무너집니다.", "p": [["여리고", 31.87, 35.44]], "r": [6, 6, 20], "z": 11}], "end": "애굽에서 여리고까지, 하나님이 구름 기둥과 불 기둥으로 앞서 가신 길이었습니다."}, {"id": "elijah", "n": "엘리야의 길", "sub": "그릿 시내에서 호렙 산까지 · 열왕기상 17–19장", "who": "엘리야", "as_": "elijah", "big": 3, "d": "가뭄을 선포한 엘리야가 숨어 지내다 갈멜 산에서 바알 선지자들과 맞서고, 이세벨을 피해 호렙 산까지 도망한 길입니다.", "start": ["디셉(길르앗)", 32.3, 35.85], "steps": [{"t": "그릿 시내에 숨다", "s": "왕상 17장", "n": "가뭄을 선포한 뒤, 엘리야는 요단 앞 그릿 시냇가에 숨고 까마귀가 먹을 것을 나릅니다.", "p": [["그릿 시내", 32.33, 35.62]], "r": [11, 17, 6], "z": 9.5}, {"t": "사르밧 과부의 집", "s": "시돈 땅", "n": "시내가 마르자 이방 땅 사르밧으로 갑니다. 과부의 통의 가루와 병의 기름이 떨어지지 않습니다.", "p": [["", 32.8, 35.6], ["사르밧", 33.37, 35.27]], "r": [11, 17, 16], "z": 8.5}, {"t": "아합에게 보이라", "s": "삼 년째", "n": "하나님의 말씀을 따라 엘리야가 숨어 있던 곳에서 나와 아합을 만나러 갑니다.", "p": [["사마리아", 32.28, 35.2]], "r": [11, 18, 1], "z": 8.5}, {"t": "갈멜 산의 불", "s": "왕상 18장", "n": "바알 선지자 사백오십 명과 맞선 갈멜 산에서, 하나님이 불로 응답하십니다.", "p": [["갈멜 산", 32.67, 35.09]], "r": [11, 18, 39], "z": 10.5}, {"t": "이스르엘까지 달려가다", "s": "큰 비", "n": "비가 쏟아지기 시작하고, 엘리야가 아합의 마차 앞에서 이스르엘까지 달립니다.", "p": [["이스르엘", 32.56, 35.33]], "r": [11, 18, 46], "z": 10}, {"t": "생명을 위해 도망하다", "s": "이세벨의 위협", "n": "이세벨이 죽이겠다고 하자, 엘리야는 유다 남쪽 끝 브엘세바까지 도망합니다.", "p": [["브엘세바", 31.24, 34.79]], "r": [11, 19, 3], "z": 8}, {"t": "로뎀 나무 아래", "s": "광야 하룻길", "n": "죽기를 구하며 누운 엘리야를 천사가 깨워 먹이십니다.", "p": [["로뎀 나무", 30.98, 34.86]], "r": [11, 19, 5], "z": 9.5}, {"t": "사십 주야를 걸어", "s": "하나님의 산 호렙", "n": "그 음식의 힘으로 사십 주야를 걸어 호렙 산에 이릅니다.", "p": [["호렙 산", 28.56, 33.95]], "r": [11, 19, 8], "z": 7.5}, {"t": "세미한 소리", "s": "굴 앞에서", "n": "바람과 지진과 불 뒤에, 세미한 소리로 하나님이 엘리야를 만나 주십니다.", "stay": 1, "r": [11, 19, 12], "z": 10.5}, {"t": "엘리사를 부르다", "s": "아벨므홀라", "n": "다시 길을 떠난 엘리야가 밭을 갈던 엘리사에게 겉옷을 던집니다. 남은 일은 엘리사가 이어 갑니다.", "p": [["", 29.25, 34.45], ["", 29.62, 35.0], ["", 30.4, 35.25], ["", 31.1, 35.68], ["", 31.8, 35.7], ["아벨므홀라", 32.35, 35.55]], "r": [11, 19, 19], "z": 7.5}], "end": "홀로 남았다고 여긴 엘리야에게, 하나님은 칠천 명을 남겨 두셨다고 말씀하십니다(왕상 19:18)."}, {"id": "paul1", "n": "바울의 1차 전도 여행", "sub": "구브로와 갈라디아 남쪽 · 사도행전 13–14장", "who": "바울", "as_": "paul", "wth": [["바나바", "man"]], "big": 6, "d": "안디옥 교회가 금식하며 기도하고 바나바와 사울을 보냅니다. 처음으로 바다 건너 이방 땅에 복음이 전해집니다.", "start": ["안디옥", 36.2, 36.16], "steps": [{"t": "안디옥 교회가 보내다", "s": "행 13:1–3", "n": "성령께서 바나바와 사울을 따로 세우라 하시고, 교회가 안수하여 보냅니다.", "p": [["실루기아", 36.12, 35.93]], "r": [44, 13, 3], "z": 9.5}, {"t": "배를 타고 구브로로", "s": "살라미", "n": "실루기아 항구에서 배를 타고 바나바의 고향 구브로 섬 살라미에 내립니다.", "p": [["", 35.75, 35.0], ["살라미", 35.18, 33.9]], "sea": 1, "r": [44, 13, 5], "z": 8}, {"t": "섬을 가로질러 바보까지", "s": "총독이 믿다", "n": "섬을 가로질러 바보에 이르고, 총독 서기오 바울이 주의 가르침을 듣고 믿습니다.", "p": [["", 35.0, 33.3], ["바보", 34.76, 32.41]], "r": [44, 13, 12], "z": 8.5}, {"t": "밤빌리아의 버가로", "s": "마가가 돌아가다", "n": "바다를 건너 버가에 이릅니다. 여기서 마가 요한은 예루살렘으로 돌아갑니다.", "p": [["", 35.6, 31.6], ["", 36.75, 30.75], ["버가", 36.96, 30.85]], "sea": 1, "r": [44, 13, 13], "z": 7.5}, {"t": "비시디아 안디옥", "s": "이방인에게 열린 문", "n": "높은 산길을 넘어 비시디아 안디옥에 이르고, 회당에서 전한 말씀을 이방인들이 기뻐하며 받습니다.", "p": [["", 37.6, 30.9], ["비시디아 안디옥", 38.31, 31.19]], "r": [44, 13, 48], "z": 8}, {"t": "이고니온", "s": "행 14장", "n": "이고니온에서도 유대인과 헬라인 큰 무리가 믿지만, 반대하는 사람들이 돌로 치려 합니다.", "p": [["이고니온", 37.87, 32.49]], "r": [44, 14, 1], "z": 8.5}, {"t": "루스드라에서 돌에 맞다", "s": "죽은 줄로 알고", "n": "걷지 못하던 사람이 일어나고, 뒤이어 쫓아온 사람들이 바울을 돌로 쳐서 성 밖에 버립니다.", "p": [["루스드라", 37.58, 32.45]], "r": [44, 14, 19], "z": 9}, {"t": "더베까지", "s": "많은 제자", "n": "다시 일어난 바울은 더베로 가서 복음을 전하고 많은 제자를 얻습니다.", "p": [["더베", 37.35, 33.36]], "r": [44, 14, 21], "z": 8.5}, {"t": "왔던 길로 돌아가며", "s": "믿음에 머물라", "n": "위험했던 성들을 다시 찾아가 제자들의 마음을 굳게 하고 장로들을 세웁니다.", "p": [["루스드라", 37.58, 32.45], ["이고니온", 37.87, 32.49], ["비시디아 안디옥", 38.31, 31.19], ["", 37.6, 30.9], ["버가", 36.96, 30.85], ["앗달리아", 36.88, 30.7]], "r": [44, 14, 22], "z": 7.5}, {"t": "안디옥으로 돌아오다", "s": "믿음의 문", "n": "배를 타고 안디옥으로 돌아와, 하나님이 이방인에게 믿음의 문을 여신 일을 교회에 알립니다.", "p": [["", 36.55, 31.0], ["", 36.0, 32.5], ["", 35.9, 34.0], ["", 36.05, 35.6], ["실루기아", 36.12, 35.93]], "sea": 1, "r": [44, 14, 27], "z": 7, "then": [["안디옥", 36.2, 36.16]]}], "end": "처음 떠난 여행에서, 복음은 바다를 건너 이방인의 땅에 뿌리를 내렸습니다."}, {"id": "paul2", "n": "바울의 2차 전도 여행", "sub": "마게도냐와 아가야로 · 사도행전 15:36–18:22", "who": "바울", "as_": "paul", "wth": [["실라", "man"]], "big": 6, "d": "바울과 실라가 1차 여행의 교회들을 다시 찾아가다가, 환상을 보고 바다를 건너 유럽 땅 마게도냐로 들어갑니다.", "start": ["안디옥", 36.2, 36.16], "steps": [{"t": "길리기아 관문을 넘어", "s": "수리아와 길리기아", "n": "바울은 실라와 함께 육로로 떠나 교회들을 굳게 하며 산길을 넘습니다.", "p": [["", 36.7, 36.3], ["", 37.05, 36.2], ["", 37.0, 35.4], ["", 37.25, 34.8], ["더베", 37.35, 33.36]], "r": [44, 15, 41], "z": 7}, {"t": "디모데를 만나다", "s": "루스드라", "n": "루스드라에서 믿음 좋은 제자 디